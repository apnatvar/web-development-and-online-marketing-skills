<mjml lang="en">
  <mj-head>
    <mj-title>{{subject}}</mj-title>
    <mj-preview>{{preview_text}}</mj-preview>
    <mj-breakpoint width="480px" />
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-body background-color="#F3F5F8" width="600px" />
      <mj-text color="#19212A" font-size="16px" line-height="25px" padding="0" />
      <mj-button background-color="#5B3DF5" color="#FFFFFF" border-radius="10px" font-size="16px" font-weight="700" inner-padding="14px 24px" />
    </mj-attributes>
    <mj-html-attributes>
      <mj-selector path=".email-heading div">
        <mj-html-attribute name="role">heading</mj-html-attribute>
        <mj-html-attribute name="aria-level">1</mj-html-attribute>
      </mj-selector>
    </mj-html-attributes>
    <mj-raw>
      <meta name="color-scheme" content="light dark">
      <meta name="supported-color-schemes" content="light dark">
    </mj-raw>
  </mj-head>
  <mj-body>
    <mj-section background-color="#111827" padding="26px 28px">
      <mj-column>
        <mj-image src="{{logo_url}}" href="{{website_url}}" alt="{{company_name}}" align="left" width="150px" padding="0" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="42px 34px 26px">
      <mj-column>
        <mj-text font-size="16px" color="#5B3DF5" font-weight="700" letter-spacing="0.7px" text-transform="uppercase">{{eyebrow}}</mj-text>
        <mj-spacer height="14px" />
        <mj-text css-class="email-heading" font-size="34px" line-height="40px" font-weight="800">{{headline}}</mj-text>
        <mj-spacer height="20px" />
        <mj-text>Hi {{first_name}},</mj-text>
        <mj-spacer height="14px" />
        <mj-text>{{body_copy}}</mj-text>
        <mj-spacer height="26px" />
        <mj-button href="{{campaign_url}}" align="left" padding="0">{{cta_label}}</mj-button>
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" padding="0 34px 38px">
      <mj-column>
        <mj-divider border-color="#E5E7EB" border-width="1px" padding="0 0 22px" />
        <mj-text font-size="13px" line-height="20px" color="#6B7280">
          You received this email because {{subscription_reason}}.<br />
          <a href="{{preferences_url}}" style="color:#5B3DF5;">Manage preferences</a> ·
          <a href="{{unsubscribe_url}}" style="color:#5B3DF5;">Unsubscribe</a><br />
          {{company_name}} · {{company_address}}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
