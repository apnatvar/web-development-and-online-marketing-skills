{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audience-context.schema.json",
  "title": "Audience context",
  "type": "object",
  "required": ["name", "role", "buyer_or_user", "pain_points", "desired_outcome", "awareness_level"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "buyer_or_user": {"enum": ["buyer", "user", "both", "influencer"]},
    "industry": {"type": "array", "items": {"type": "string"}},
    "organisation_size": {"type": "array", "items": {"type": "string"}},
    "technical_sophistication": {"enum": ["low", "moderate", "high", "mixed", "unknown"]},
    "alternatives": {"type": "array", "items": {"type": "string"}},
    "pain_points": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "objections": {"type": "array", "items": {"type": "string"}},
    "desired_outcome": {"type": "string", "minLength": 1},
    "awareness_level": {"enum": ["unaware", "problem_aware", "solution_aware", "product_aware", "most_aware", "mixed"]},
    "geographies": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}

