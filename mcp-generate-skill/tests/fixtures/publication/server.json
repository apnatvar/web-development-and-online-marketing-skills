{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.example/catalog-mcp",
  "title": "Catalog MCP",
  "description": "Search a public product catalog.",
  "version": "1.2.3",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@example/catalog-mcp",
      "version": "1.2.3",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        {
          "name": "CATALOG_API_KEY",
          "description": "Catalog API key.",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.example.com/mcp"
    }
  ]
}
